generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// FREE or PRO. Nothing charges for Pro yet: what each plan unlocks is one list in
// src/lib/plans.ts, and an account is upgraded by hand (see the README) until payments exist.
enum Plan {
  FREE
  PRO
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  plan            Plan      @default(FREE)
  // what booking amounts in the inbox and analytics are counted in: an ISO code like "INR"
  currency        String    @default("USD")
  // what they'd like to book in a calendar month, shown as progress in the inbox
  monthlyGoal     Int?
  // the Monday email with last week's numbers
  weeklyEmail     Boolean   @default(true)
  // where clients pay them: a payment page address or a UPI id, remembered from the last request
  paymentLink     String?
  // set when they click the link in the welcome email; nothing is blocked before that
  emailVerifiedAt DateTime?
  // finished (or skipped) the first-run questions at /welcome; until then the editor sends them there
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())

  page     Page?
  sessions Session[]
  media    Media[]
  tokens   Token[]
}

enum TokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A one-time link sent by email. Like sessions, only the sha256 of the token is kept, and a
// token is deleted the moment it's used.
model Token {
  id        String    @id
  userId    Int
  kind      TokenKind
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // the daily clean-up deletes the expired ones
  @@index([expiresAt])
}

// A signed-in browser. The cookie holds a random token; only its sha256 is stored here, so a
// leaked database can't be used to sign in. Deleting the row signs that browser out.
model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Each person has one page, at roselle.page/<username>.
// The whole page (profile, theme, blocks) is one JSON document checked by pageSchema
// (src/lib/validations/page.ts). The editor autosaves into `draft`; Publish copies it to
// `published`, which is the only one visitors ever see.
model Page {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  username    String    @unique
  draft       Json
  published   Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  // taken down by an admin for breaking the rules: visitors get a 404 until it's restored.
  // The reason is what the owner is told.
  suspendedAt     DateTime?
  suspendedReason String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  reports   Report[]
  enquiries Enquiry[]
  reviews   Review[]
}

// Where an enquiry is on its way to paid work. The creator moves it along in the inbox.
enum EnquiryStatus {
  NEW
  REPLIED
  BOOKED
  PAID
  // not going ahead
  CLOSED
}

// A message a visitor sent through a "Work with me" or Services block. The creator gets it by
// email (Reply goes straight to the visitor) and in their inbox at /inbox, where it becomes a
// booking.
model Enquiry {
  id        Int           @id @default(autoincrement())
  pageId    Int
  name      String
  email     String
  // their WhatsApp number, if they gave one, so a payment or review request can open their chat
  phone     String?
  message   String
  // the service they asked about, as it was named then, so renaming it later doesn't rewrite history
  service   String?
  // the date they'd like it, "2026-12-05"; a plain date with no time zone, as they picked it
  wantedOn  String?
  // where the visitor came from ("instagram.com", "direct"), worked out like page views are
  source    String        @default("direct")
  status    EnquiryStatus @default(NEW)
  // what the booking is worth, in whole units of the creator's currency
  // ponytail: whole units only (no cents); store minor units if invoices ever need exact amounts
  amount    Int?
  // when it became a booking; "booked this month" is counted from this
  bookedAt  DateTime?
  // when the creator first moved it on from New: how fast they reply
  repliedAt DateTime?
  // the morning reminder about it went out (once per enquiry)
  remindedAt DateTime?
  // asking the client for a review: the hash of the one-time link, and when it was sent
  reviewTokenHash   String?   @unique
  reviewRequestedAt DateTime?
  // the latest payment request emailed to the client
  paymentRequestedAt     DateTime?
  paymentRequestedAmount Int?
  createdAt DateTime      @default(now())
  // opened in the inbox
  readAt    DateTime?

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  review Review?

  @@index([pageId, createdAt])
  @@index([status, createdAt])
}

// What a client said after the work. Only the one-time link sent from their own enquiry can
// leave one, so every review is from someone who really paid. Shown once the creator approves it.
model Review {
  id         Int       @id @default(autoincrement())
  pageId     Int
  // the enquiry it came from; kept if that enquiry is deleted later
  enquiryId  Int?      @unique
  name       String
  rating     Int
  text       String
  // the service, as named when the work was booked
  service    String?
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([pageId, approvedAt])
}

// A visitor flagging a page (the "Report" link at the bottom of every public page).
// Admins work through the open ones at /admin.
model Report {
  id         Int       @id @default(autoincrement())
  pageId     Int
  // one of REPORT_REASONS in src/lib/validations/report.ts
  reason     String
  details    String
  // only if they want to hear back
  email      String?
  createdAt  DateTime  @default(now())
  // dismissed, or the page was taken down
  resolvedAt DateTime?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

enum EventType {
  VIEW
  CLICK
}

// One visit to a page, or one click on a link in it. Analytics are counted from these rows.
model Event {
  id        Int       @id @default(autoincrement())
  pageId    Int
  type      EventType
  // the clicked block's id inside the page JSON (clicks only). Not a relation: blocks aren't rows
  blockId   String?
  // a hash of IP + browser + day, never the IP itself; the same person on the same day counts once
  visitorId String
  // where the visit came from: "instagram.com", "direct", or ?utm_source=
  source    String
  // "mobile", "tablet" or "desktop"
  device    String
  createdAt DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // every analytics question is "this page, views (or clicks), since this date", in that order
  @@index([pageId, type, createdAt])
}

// Uploaded images (avatars, gallery pictures), served by /media/<id>
// ponytail: stored in Postgres as bytes; move them to object storage (S3/R2) once there are many
model Media {
  id        String   @id @default(cuid())
  userId    Int
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
