# Postgres. Locally: createdb roselle
DATABASE_URL="postgresql://USER@localhost:5432/roselle"
# Only on hosts with a connection pooler (Neon): the direct, unpooled address, for migrations
DIRECT_URL=""

# The public address, for share images and links (production)
APP_URL="http://localhost:3000"

# Mixed into the daily visitor hash, so a visitor id can't be traced back to an IP address.
# Any long random string: openssl rand -hex 32
VISITOR_SALT=""

# Email (password resets, confirming addresses) through Brevo's free plan: 300 emails a day.
# Leave empty locally and the emails are printed in the terminal instead.
BREVO_API_KEY=""
# the sender address you verified in Brevo
MAIL_FROM=""

# Who can open /admin to handle reports and take pages down: your sign-in email(s), comma separated.
# They also get an email for every new report.
ADMIN_EMAILS=""
# The address shown on the privacy and terms pages for questions and takedown requests.
# Empty = MAIL_FROM.
CONTACT_EMAIL=""

# Protects the daily job (/api/cron/daily: reminders, and the weekly email on Mondays). Vercel
# sends it automatically once set. Any long random string: openssl rand -hex 32
CRON_SECRET=""
